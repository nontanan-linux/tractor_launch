<?xml version="1.0"?>
<robot name="vehicle" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="config_dir" default="$(find tractor_sensor_kit_description)/config"/>
  <xacro:include filename="$(find tractor_sensor_kit_description)/urdf/sensor_kit.xacro"/>
  
  <xacro:sensor_kit_macro>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_kit_macro>
</robot>
