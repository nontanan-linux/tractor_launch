<launch>
  <!-- รับค่าตัวแปรจากผู้ใช้ (ส่งต่อให้ Autoware) -->
  <arg name="map_path" default="/home/tacv/autoware_map/minebae" description="Path to the map directory"/>
  
  <!-- บังคับเปลี่ยน vehicle_model เป็น tractor (Autoware จะเติม _description ต่อท้ายเอง) -->
  <arg name="vehicle_model" default="tractor" description="Vehicle model package name"/>
  
  <arg name="sensor_model" default="tractor_sensor_kit" description="Sensor model package name"/>
  <arg name="rviz" default="true" description="Launch RViz"/>

  <!-- เรียกใช้งาน planning_simulator.launch.xml ของ autoware_launch ของจริง -->
  <include file="$(find-pkg-share autoware_launch)/launch/planning_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>

  <!-- รัน nmb_odometer_node ตรงนี้เลย เพราะ Autoware ข้าม vehicle.launch.xml ไป -->
  <node pkg="tractor_description" exec="nmb_odometer_node" name="nmb_odometer_node" output="screen">
    <param from="$(find-pkg-share tractor_description)/config/vehicle_info.param.yaml"/>
    <param name="use_sim_time" value="true"/>
    <!-- กำหนดความสูง Z ของแผนที่ (เช่น ถ้าล้อจมดิน ให้เพิ่มค่านี้ เช่น 40.0) -->
    <param name="map_elevation" value="0.0"/>
  </node>

</launch>
